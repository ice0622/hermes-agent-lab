#!/usr/bin/env python3
"""健康管理エージェント CLI（フェーズ0 — Hermes 不要）

記録・集計・診断は LLM を使わない。`nl` だけが API を呼ぶ。

  health init                      DB 作成 + マスタ投入
  health import [path]             手書き記録の Markdown を取り込む
  health t [push|pull|legs]        ルーティンのメニューを表示
  health today                     今日の摂取と不足
  health check [--apply]           診断: 問題点と次のアクション
  health report                    dashboard.html を生成して一覧を見る
  health plan                      次にやるメニューを計算して plans に保存
                                   （Web ダッシュボードが読む。記録のたびに自動で走る）
  health suggest                   残りを埋める買い物リスト（LLM 不使用）
  health last                       直近の記録を表示
  health undo                       直前の記録を取り消す

  health prompt [> file]           ブラウザの Claude に渡すプロンプトを出す
                                   （マスタ + 書式の指示。API キー不要の経路）
  health batch [file]              ブラウザの Claude が返した行をまとめて記録する
                                   （省略時は標準入力。1回の undo で全部消せる）

  health nl "8/25は朝おにぎり2つ。ベンチ40キロ8回8回6回。65.2キロ"
                                   自由入力（ここだけ API を呼ぶ。要 ANTHROPIC_API_KEY）
                                   食事・筋トレ・体重をまとめて受け付ける。
                                   日付を書かなければ今日として記録する

  health bp 60 8,8,7               筋トレ（種目コード + 重量 + レップ）
  health w 64.2                    体重
  health m サラダチキン, おにぎり*2  食事

どの記録コマンドにも --date を付けられる（`health w 65.2 --date 8/25`）。
`8/25` `昨日` `3日前` `先週の火曜` を解釈する。省略すれば今日。

DB の場所は環境変数 HEALTH_DB、無ければ ~/health/health.db。
"""

from __future__ import annotations

import sys
from datetime import date
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from lib import (  # noqa: E402
    batch, db, dates, diagnose, history, nl, parse, report, resolve, store, suggest, train,
)

SUBCOMMANDS = {"init", "import", "today", "check", "last", "undo", "nl", "n", "report", "suggest",
                "prompt", "batch", "b", "plan", "help", "--help", "-h"}
WEEKDAYS = "月火水木金土日"


def main(argv: list[str]) -> int:
    if not argv or argv[0] in {"help", "--help", "-h"}:
        print(__doc__)
        return 0

    cmd, rest = argv[0], argv[1:]
    if cmd == "init":
        return cmd_init()
    if cmd == "import":
        return cmd_import(rest)
    if cmd == "today":
        return cmd_today()
    if cmd == "check":
        return cmd_check("--apply" in rest)
    if cmd == "last":
        return cmd_last()
    if cmd == "undo":
        return cmd_undo()
    if cmd == "suggest":
        return cmd_suggest("--plain" in rest)
    if cmd == "report":
        return cmd_report(rest)
    if cmd == "plan":
        return cmd_plan()
    if cmd == "prompt":
        return cmd_prompt()
    if cmd in {"batch", "b"}:
        return cmd_batch(rest)
    if cmd in {"nl", "n"}:
        return cmd_nl(rest)
    if cmd == "log":
        return cmd_log(rest)
    return cmd_log(argv)


# ---------------------------------------------------------------- init / import


def cmd_init() -> int:
    p = db.db_path()
    fresh = not p.exists()
    conn = db.connect(create=True)
    conn.executescript((db.DDL_DIR / "schema.sql").read_text(encoding="utf-8"))
    if applied := db.migrate(conn):
        print("列を追加: " + ", ".join(applied))
    for name in ("seed_exercises.sql", "seed_foods.sql", "seed_dishes.sql"):
        conn.executescript((db.DDL_DIR / name).read_text(encoding="utf-8"))
    conn.commit()

    counts = {
        t: conn.execute(f"SELECT COUNT(*) c FROM {t}").fetchone()["c"]
        for t in ("exercises", "routines", "foods", "targets")
    }
    print(f"{'作成' if fresh else '更新'}: {p}")
    print("  種目 {exercises} / ルーティン {routines} / 食品 {foods} / 目標 {targets}".format(**counts))
    if t := db.current_target(conn):
        print(
            f"  目標: {t['kcal']:.0f}kcal  P{t['protein']:.0f}  F{t['fat']:.0f}  C{t['carb']:.0f}"
        )
    print("\n次: health import   （手書き記録1年分を投入して、初日からグラフが出る状態にする）")
    return 0


def cmd_import(rest: list[str]) -> int:
    default = db.REPO_ROOT.parent.parent / "docs" / "training-history.md"
    path = Path(rest[0]) if rest else default
    if not path.exists():
        print(f"ファイルがありません: {path}", file=sys.stderr)
        return 1

    conn = db.connect()
    res = history.import_into(conn, path)
    print(f"取り込み: {path.name}")
    print(f"  セッション {res.sessions} / セット {res.set_rows} 行 / 体重 {res.body_rows} 行")
    if res.skipped:
        print(f"  スキップ（種目未登録）: {len(res.skipped)} 件")
        for s in res.skipped:
            print(f"    - {s}")
    if res.unmapped:
        print(f"  対応表に無い表記: {len(res.unmapped)} 件")
        for s in res.unmapped[:10]:
            print(f"    - {s}")
    _replan(conn)
    return 0


# ---------------------------------------------------------------- 貼り付け経路


def cmd_prompt() -> int:
    """ブラウザの Claude に渡すプロンプトを標準出力に出す。

    API キーが無い環境ではこれが主経路になる。`nl` と違うのは
    「LLM を誰が呼ぶか」だけで、日付計算とマスタ解決は同じコードを通る。
    """
    conn = db.connect()
    text = batch.prompt(conn)
    print(text, end="")
    if sys.stdout.isatty():
        print(
            "\n" + "-" * 60 + "\n"
            "上をコピーしてブラウザの Claude に渡してください。\n"
            "  ファイルに出す:  health prompt > ~/health/master.md\n"
            "  claude.ai の Project に添付しておくと、毎回貼らなくて済みます。\n"
            "  マスタに品や種目が増えたら貼り直してください。",
            file=sys.stderr,
        )
    return 0


def cmd_batch(rest: list[str]) -> int:
    conn = db.connect()
    src = [a for a in rest if a != "-"]
    if src:
        path = Path(src[0])
        if not path.exists():
            print(f"ファイルがありません: {path}", file=sys.stderr)
            return 1
        text = path.read_text(encoding="utf-8")
    elif sys.stdin.isatty():
        print(
            "貼り付ける内容がありません。\n"
            "  health batch <<'EOF'\n"
            "  --date 8/25 w 65.2\n"
            "  EOF",
            file=sys.stderr,
        )
        return 1
    else:
        text = sys.stdin.read()

    res = batch.apply(conn, text)
    for line in res.echo:
        print(line)
    if res.writes:
        _replan(conn)

    if not res.writes and not res.errors:
        print("記録できる行がありませんでした。", file=sys.stderr)
        return 1

    if len(res.days) > 1:
        print(f"\n{len(res.days)} 日分に分けて記録しました: " + "、".join(res.days))
    if res.writes:
        print("  取り消す場合は health undo（今入れた分すべて）")

    if res.errors:
        # 通った行はそのまま残す。1行のミスで全部やり直しにすると貼り直さなくなる
        # stderr に出す前に stdout を吐く。混ざると「何が入ったか」が読めなくなる
        sys.stdout.flush()
        print(f"\n読めなかった行 {len(res.errors)} 件（他の行は記録済み）:", file=sys.stderr)
        for e in res.errors:
            print(f"  ! {e}", file=sys.stderr)
        return 1
    return 0


# ---------------------------------------------------------------- 記録


def cmd_log(argv: list[str]) -> int:
    conn = db.connect()
    argv, when = dates.pop_flag(argv)
    try:
        cmd = parse.parse(" ".join(argv))
    except parse.ParseError as e:
        print(e, file=sys.stderr)
        return 1

    if isinstance(cmd, parse.Menu):
        return show_menu(conn, cmd.split)

    on = None if when.assumed else when.date
    if isinstance(cmd, parse.Train):
        w = store.write_train(conn, cmd, on=on)
        _replan(conn)
    elif isinstance(cmd, parse.Body):
        w = store.write_body(conn, cmd, on=on)
    else:
        w = store.write_meal(conn, cmd, on=on)

    # 当日以外に入れたときだけ日付を出す。毎回出すと読み飛ばされる
    prefix = "記録" if when.assumed else f"記録 [{w.day}]"
    print(f"{prefix}: {w.summary}")
    if when.warning:
        print(f"  ! {when.warning}")
    for warn in w.warnings:
        print(f"  ! {warn}")
    return 0


def show_menu(conn, split: str | None) -> int:
    split = split or resolve.suggest_split(conn)
    rows = resolve.menu(conn, split)
    if not rows:
        print(f"{split} のルーティンが未登録です。", file=sys.stderr)
        return 1
    resolve.save_last_menu(rows, split)

    last = conn.execute(
        """SELECT MAX(s.date) d FROM sets s JOIN exercises e ON e.id = s.exercise_id
           WHERE e.split = ?""",
        (split,),
    ).fetchone()["d"]
    print(f"{split}  （前回: {last or '記録なし'}）")
    for r in rows:
        prev = conn.execute(
            """SELECT weight, reps FROM sets WHERE exercise_id = ?
               ORDER BY date DESC, set_no ASC LIMIT 1""",
            (r["id"],),
        ).fetchone()
        hint = f"前回 {prev['weight']:g}kg×{prev['reps']}" if prev else "記録なし"
        print(f"  {r['ord']}. {r['name']:<22} {r['code']:<5} {hint}")
    print("\n  番号で指定できます:  health 1 60 8,8,7")
    return 0


def cmd_last() -> int:
    conn = db.connect()
    print("直近の記録\n")
    for label, sql in (
        ("体重", "SELECT date, weight, body_fat FROM body ORDER BY date DESC LIMIT 3"),
        (
            "筋トレ",
            """SELECT s.date, e.name, s.weight, s.reps, s.set_no FROM sets s
               JOIN exercises e ON e.id = s.exercise_id ORDER BY s.id DESC LIMIT 6""",
        ),
        (
            "食事",
            "SELECT date, food_name, qty, kcal FROM meals ORDER BY id DESC LIMIT 6",
        ),
    ):
        rows = conn.execute(sql).fetchall()
        print(f"■ {label}")
        if not rows:
            print("  （なし）")
        for r in rows:
            print("  " + "  ".join(f"{k}={r[k]}" for k in r.keys() if r[k] is not None))
        print()
    return 0


def cmd_undo() -> int:
    conn = db.connect()
    print(f"取り消しました: {store.undo(conn)}")
    _replan(conn)   # セットが消えたらメニューの前提も変わる
    return 0


# ---------------------------------------------------------------- 買い物リスト


def cmd_suggest(plain: bool) -> int:
    conn = db.connect()
    need = suggest.current_need(conn)
    if need is None:
        print("目標が未設定です。`health init` を実行してください。", file=sys.stderr)
        return 1
    print(suggest.format_plans(need, suggest.plans(conn, need), plain=plain))
    return 0


# ---------------------------------------------------------------- 次のメニュー


def _replan(conn) -> None:
    """次のメニューを計算して plans に置き直す。

    記録そのものは通っているので、ここで失敗しても記録は取り消さない。
    「記録が止まるのが最悪」という方針（docs/plan.md T02）をメニュー側にも適用する。
    """
    try:
        train.materialize(conn)
    except Exception as e:  # noqa: BLE001 — 記録を巻き込まないため意図的に広く受ける
        print(f"  ! メニューの再計算に失敗（記録は入っています）: {e}", file=sys.stderr)


def cmd_plan() -> int:
    conn = db.connect()
    n = train.materialize(conn)
    rows = conn.execute("SELECT * FROM v_next_plan").fetchall()
    if not rows:
        print("ルーティンが未登録です。", file=sys.stderr)
        return 1
    print(f"次は {rows[0]['split']}  （{rows[0]['computed_at']} 時点 / 全 {n} 行）\n")
    for r in rows:
        load = "自重" if r["weight"] == 0 else f"{r['weight']:g}kg"
        print(f"  {r['ord']}. {r['name']}")
        print(f"     {load} × {r['reps'].replace('/', '回 → ')}回")
        print(f"     {r['reason']}")
        print(f"     前回 {r['last_txt']}")
    return 0


# ---------------------------------------------------------------- ダッシュボード


def cmd_report(rest: list[str]) -> int:
    conn = db.connect()
    out = Path(rest[0]) if rest else db.db_path().parent / "dashboard.html"
    p = report.write(conn, out)
    print(f"生成: {p}")
    print(f"  ブラウザで開く: file://{p}")
    return 0


# ---------------------------------------------------------------- 自由入力


def cmd_nl(rest: list[str]) -> int:
    if not rest:
        print(
            '例: health nl "8/25は朝おにぎり2つ。ベンチ40キロ8回8回6回。65.2キロ"',
            file=sys.stderr,
        )
        return 1
    conn = db.connect()
    rest, override = dates.pop_flag(rest)
    text = " ".join(rest)
    if not text.strip():
        print("入力が空です。", file=sys.stderr)
        return 1

    res = nl.interpret(conn, text)
    if added := nl.upsert_new_foods(conn, res):
        print("マスタに追加（source='llm'、あとで実物のラベルで直す）:")
        for a in added:
            print(f"  + {a}")
        print()

    plan = nl.build_plan(conn, res)
    # --date は文中に日付が無かったものだけ上書きする。
    # 「8/25は〜」と書いてあるものを --date で潰すと、書いたほうが無視されて事故になる
    if not override.assumed:
        plan = _apply_override(plan, override)

    if plan.is_empty():
        print("記録できるものが読み取れませんでした。", file=sys.stderr)
        for pb in plan.problems:
            print(f"  ? {pb}", file=sys.stderr)
        return 1

    writes: list[store.Written] = []
    for cmd, when in plan.trainings:
        writes.append(_emit(store.write_train(conn, cmd, on=_on(when)), when))
    for cmd, when in plan.meals:
        writes.append(_emit(store.write_meal(conn, cmd, on=_on(when)), when))
    for cmd, when in plan.body:
        writes.append(_emit(store.write_body(conn, cmd, on=_on(when)), when))

    if plan.trainings:
        _replan(conn)

    # 1回の発言で入ったものは、1回の undo でまとめて消せるようにする
    store.remember_batch(writes)

    days = sorted({w.day for w in writes})
    if len(days) > 1:
        print(f"\n{len(days)} 日分に分けて記録しました: " + "、".join(days))
    print("  取り消す場合は health undo（今入れた分すべて）")

    if plan.problems:
        print("\n判別できず推定で埋めた点:")
        for pb in plan.problems:
            print(f"  ? {pb}")
    return 0


def _on(when: dates.Resolved):
    """当日なら None を渡して現在時刻を使わせる。遡るときだけ日付を渡す。"""
    return None if when.assumed else when.date


def _apply_override(plan: nl.Plan, override: dates.Resolved) -> nl.Plan:
    def fix(pairs):
        return [(cmd, override if when.assumed else when) for cmd, when in pairs]

    return nl.Plan(
        trainings=fix(plan.trainings),
        meals=fix(plan.meals),
        body=fix(plan.body),
        problems=plan.problems,
    )


def _emit(w: store.Written, when: dates.Resolved) -> store.Written:
    print(f"記録 [{w.day}]: {w.summary}")
    if when.warning:
        print(f"  ! {when.warning}")
    for warn in w.warnings:
        print(f"  ! {warn}")
    return w


# ---------------------------------------------------------------- today


def cmd_today() -> int:
    conn = db.connect()
    d = date.today()
    print(f"{d.isoformat()}（{WEEKDAYS[d.weekday()]}）\n")

    t = db.current_target(conn)
    if t is None:
        print("目標が未設定です。`health init` を実行してください。", file=sys.stderr)
        return 1

    got = conn.execute("SELECT * FROM v_today").fetchone()
    vals = {
        k: (got[k] if got else 0) for k in ("kcal", "protein", "fat", "carb")
    }
    print(f"{'':6}{'摂取':>9}{'目標':>9}{'残り':>9}")
    for key, label, unit in (
        ("kcal", "kcal", ""), ("protein", "P", "g"), ("fat", "F", "g"), ("carb", "C", "g"),
    ):
        got_v, tgt_v = vals[key], t[key]
        print(f"{label:<6}{got_v:>8.0f}{unit:<1}{tgt_v:>8.0f}{unit:<1}{tgt_v - got_v:>8.0f}{unit}")

    unknown = conn.execute(
        "SELECT DISTINCT food_name FROM meals WHERE date = ? AND food_id IS NULL",
        (d.isoformat(),),
    ).fetchall()
    if unknown:
        names = "、".join(r["food_name"] for r in unknown)
        print(f"\n! マスタに無い食品がカロリー0で入っています: {names}")

    body = conn.execute("SELECT weight FROM body WHERE date = ?", (d.isoformat(),)).fetchone()
    print(f"\n体重: {body['weight']}kg" if body else "\n体重: 今日は未記録  → health w 64.2")
    return 0


# ---------------------------------------------------------------- check


LABEL = {"stop": "[要対応]", "warn": "[注意]", "ok": "[OK]"}


def cmd_check(apply: bool) -> int:
    conn = db.connect()
    rep = diagnose.run(conn)
    print(f"診断 {date.today().isoformat()}\n")

    if not rep.findings:
        print("指摘なし。記録を続けてください。")
        return 0

    for fi in rep.findings:
        print(f"■ {fi.title}  {LABEL[fi.severity]}")
        print(f"  {fi.evidence}")
        for line in fi.action.split("\n"):
            print(f"  → {line}" if not line.startswith("  ") else f"  {line}")
        print()

    if rep.target_change:
        c = rep.target_change
        cur = db.current_target(conn)
        print("提案されている目標の変更")
        print(f"  {cur['kcal']:.0f}kcal → {c.kcal:.0f}kcal  /  C {cur['carb']:.0f}g → {c.carb:.0f}g")
        print(f"  理由: {c.note}")
        if apply:
            diagnose.apply_change(conn, c)
            print("  → 適用しました。")
        else:
            print("  → 適用するには: health check --apply")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
