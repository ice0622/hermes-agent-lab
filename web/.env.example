# ローカル開発: WSL2 上の SQLite をそのまま読む。
# 絶対パスで書く（$HOME は展開されない）。既定の置き場は ~/health/health.db。
DATABASE_URL=file:/home/YOUR_USER/health/health.db

# 本番（Turso）。ダッシュボードの Database URL と auth token をそのまま貼る
# DATABASE_URL=libsql://<name>-<org>.turso.io
# DATABASE_AUTH_TOKEN=<turso で発行したトークン>

# 本番の Basic 認証。**未設定だと middleware が 503 を返して閉じる**
# （Hobby プランでは Vercel Authentication が本番に使えないため）
# DASHBOARD_PASSWORD=<好きなパスワード>
# DASHBOARD_USER=<省略可。設定するとユーザー名も照合する>
